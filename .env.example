# Copie para .env e preencha. Não coloque o .env no git.

# --- Desenvolvimento local ---
DB_NAME=corelist
DB_USER=teste
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Produção ---
# DEBUG=False
# SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# ALLOWED_HOSTS=seu-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://seu-frontend.vercel.app
# Se a hospedagem der uma URL do banco, ela substitui as variáveis DB_*:
# DATABASE_URL=postgres://usuario:senha@host:5432/nome

# --- Assistente de preços (opcional) ---
# Gemini (plano gratuito): chave em aistudio.google.com. Também usada nos insights.
# GEMINI_API_KEY=
# Claude (pago por uso): chave em console.anthropic.com.
# ANTHROPIC_API_KEY=
# Com as duas chaves, o Gemini responde primeiro; ASSISTENTE_IA=claude inverte.
# Sem nenhuma, o chat responde com frases prontas.

# --- Insights com Gemini (opcional) ---
# GEMINI_API_KEY=

