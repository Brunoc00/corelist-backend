# Copie para deploy/.env NO SERVIDOR e preencha. Nunca coloque no git.

# Domínio do backend. Com o IP elástico 54.207.10.20, use:
# DOMINIO=54-207-10-20.sslip.io
DOMINIO=

# Django
DEBUG=False
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# O mesmo valor de DOMINIO.
ALLOWED_HOSTS=
# Endereço do frontend no Amplify, com https e sem barra no fim.
# Ex.: https://mvp-comprafacil.d1abc23.amplifyapp.com
CORS_ALLOWED_ORIGINS=

# Banco (PostgreSQL no mesmo servidor)
DB_NAME=comprafacil
DB_USER=comprafacil
# Senha longa e aleatória (mesmo comando do SECRET_KEY).
DB_PASSWORD=

# Opcional: insights com Gemini
# GEMINI_API_KEY=
